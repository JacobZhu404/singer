.card {
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(6, 78, 59, 0.04);
}

.card-hover {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.num {
  display: inline-block;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #059669;
  color: #fff;
  border-radius: 50%;
  font-weight: bold;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.source {
  color: #047857;
  margin-right: 12rpx;
}

.dim {
  background: #f0fdf4;
  color: #047857;
  border: 1rpx solid #bbf7d0;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

.title {
  font-size: 31rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.summary {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
}

.copy-hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #9ca3af;
  text-align: right;
}
