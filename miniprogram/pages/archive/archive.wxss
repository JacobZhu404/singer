.arch-head {
  font-size: 36rpx;
  font-weight: 800;
  color: #047857;
  padding: 8rpx 8rpx 24rpx;
}

.arch-item {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
}

.arch-hover {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.arch-left {
  flex: 1;
  min-width: 0;
}

.arch-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arch-sub {
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.arch-total {
  font-size: 24rpx;
  color: #047857;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-right: 16rpx;
  white-space: nowrap;
}

.arch-arrow {
  font-size: 44rpx;
  color: #cbd5e1;
  line-height: 1;
}
