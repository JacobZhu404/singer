<view class="page">
  <view class="arch-head">往期晨报</view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:else>
    <view
      class="arch-item"
      wx:for="{{issues}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="openIssue"
      hover-class="arch-hover"
    >
      <view class="arch-left">
        <view class="arch-title">{{item.title}}</view>
        <view class="arch-sub">{{item.date_display}}</view>
      </view>
      <view class="arch-total">{{item.total}}条</view>
      <view class="arch-arrow">›</view>
    </view>

    <view wx:if="{{issues.length === 0}}" class="empty">暂无往期内容</view>
  </view>
</view>
