.hero {
  background: linear-gradient(135deg, #064e3b, #059669);
  color: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(6, 78, 59, 0.25);
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  opacity: 0.7;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  margin: 10rpx 0 6rpx;
  letter-spacing: 2rpx;
}

.hero-date {
  font-size: 27rpx;
  opacity: 0.9;
}

.hero-total {
  font-size: 28rpx;
  margin-top: 18rpx;
  opacity: 0.95;
}

.hero-total .hl {
  font-size: 44rpx;
  font-weight: 800;
  color: #a7f3d0;
  margin: 0 6rpx;
}

.editor-note {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 16rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  border-left: 8rpx solid #059669;
  margin: 24rpx 0 16rpx;
}

.sec-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.sec-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #047857;
}

.sec-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: #f0fdf4;
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
}
