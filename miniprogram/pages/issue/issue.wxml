<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{issue}}">
    <view class="hero">
      <view class="hero-kicker">AUTONOMOUS DRIVING · DAILY BRIEF</view>
      <view class="hero-title">自动驾驶晨报</view>
      <view class="hero-date">{{issue.date_display}}</view>
      <view class="hero-total">本期精选 <text class="hl">{{issue.total}}</text> 条</view>
    </view>

    <view class="editor-note" wx:if="{{issue.editor_note}}">{{issue.editor_note}}</view>

    <view class="section" wx:for="{{issue.sections}}" wx:key="id" wx:for-item="sec">
      <view class="sec-head">
        <text class="sec-icon">{{sec.icon}}</text>
        <text class="sec-name">{{sec.name}}</text>
        <text class="sec-count">{{sec.items.length}}</text>
      </view>
      <news-card
        wx:for="{{sec.items}}"
        wx:key="num"
        wx:for-item="it"
        item="{{it}}"
        num="{{it.num}}"
      ></news-card>
    </view>

    <view class="footer">
      <view>数据来自公开互联网消息 · 点击卡片可复制原文链接</view>
      <view>长按右上角「···」即可转发给好友或分享到朋友圈</view>
    </view>
  </block>

  <view wx:else class="empty">暂无内容</view>
</view>
