{# 微信公众号正文模板 — 所有样式用 inline style，不含 <a> 标签 #}
{# 数据来源: outline.json，由 generate_wechat.py 渲染 #}

{#- Header -#}
<section style="padding:14px 12px;background:linear-gradient(135deg,#064e3b,#059669);color:#fff;border-radius:8px;margin-bottom:14px;">
<p style="margin:0;font-size:11px;letter-spacing:2px;opacity:.7;">AUTONOMOUS DRIVING · DAILY BRIEF</p>
<p style="margin:6px 0;font-size:24px;font-weight:bold;">自动驾驶晨报</p>
<p style="margin:0;font-size:14px;opacity:.85;">{{ date_display }}</p>
<p style="margin:10px 0 0;font-size:15px;">本期精选 <strong style="font-size:22px;color:#a7f3d0;">{{ total }}</strong> 条</p>
</section>

{#- 概览表 -#}
<section style="margin:0 0 14px;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
<p style="margin:0 0 8px;font-size:14px;font-weight:bold;color:#047857;">📋 今日概览 · {{ total }} 条</p>
<table style="border-collapse:collapse;min-width:458px;"><tbody>
{% for item in flat_items -%}
<tr><td data-colwidth="43" style="padding:6px 2px;vertical-align:middle;text-align:center;"><span style="display:inline-block;width:16px;height:16px;line-height:16px;text-align:center;background:#059669;color:#fff;border-radius:50%;font-size:9px;font-weight:bold;">{{ item.num }}</span></td><td style="padding:4px 4px;font-size:12px;color:#1a1a2e;line-height:1.4;">{{ item.title_esc }}</td><td style="padding:6px 2px;font-size:10px;color:#059669;white-space:nowrap;vertical-align:middle;">{{ item.sec_short }}</td><td style="padding:6px 2px;font-size:10px;color:#6b7280;white-space:nowrap;vertical-align:middle;">{{ item.source_esc }}</td></tr>
{% endfor -%}
</tbody></table></section>

{#- 备注 -#}
<p style="margin:0 0 14px;padding:10px 12px;font-size:12px;color:#6b7280;line-height:1.6;border-radius:6px;background:#f9fafb;">本文内容均来自互联网公开消息，如果您有感兴趣的话题/公司，或者对本文的建议，请在评论区留言，感谢关注！</p>

{#- 板块详情 -#}
{% for sec in sections_nonempty -%}
<p style="margin:16px 0 8px;padding-left:8px;border-left:4px solid #059669;font-size:18px;font-weight:bold;color:#047857;">{{ sec.name }}</p>
{% for card in sec.cards -%}
<section style="margin:10px 0;padding:10px 12px;border:1px solid #e5e7eb;border-radius:8px;background:#fafafa;">
<p style="margin:0 0 4px;font-size:13px;color:#6b7280;"><span style="display:inline-block;min-width:22px;height:22px;line-height:22px;text-align:center;background:#059669;color:#fff;border-radius:50%;font-weight:bold;margin-right:6px;">{{ card.num }}</span>{{ card.source_esc }} · {{ card.date }}</p>
<p style="margin:4px 0;font-size:16px;font-weight:bold;color:#111827;">{{ card.title_esc }}</p>
<p style="margin:4px 0;font-size:14px;color:#374151;line-height:1.7;">{{ card.summary_esc }}</p>
</section>
{% endfor -%}
{% endfor -%}

{#- Footer -#}
<section style="margin:16px 0 0;padding:12px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;text-align:center;">
<p style="margin:0;font-size:14px;font-weight:600;color:#065f46;">📎 全部原文链接汇总</p>
<p style="margin:6px 0 0;font-size:13px;color:#4a5568;">点击文章底部「阅读原文」查看所有原文链接</p>
</section>
