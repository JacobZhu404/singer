<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>{{ title }}</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:#f4f6f9;color:#333;line-height:1.5;font-size:14px;-webkit-font-smoothing:antialiased}
.header{background:linear-gradient(135deg,#064e3b,#059669);padding:16px 14px;text-align:center}
.header .sub{font-size:10px;color:#a7f3d0;letter-spacing:1px;opacity:.7;margin-bottom:2px}
.header h1{font-size:20px;font-weight:700;color:#fff;margin:0}
.header .meta{font-size:11px;color:#d1fae5;margin-top:4px;opacity:.85}
.overview{background:#fff;margin:10px 14px;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.04);overflow-x:auto}
.overview-title{font-size:13px;font-weight:700;color:#064e3b;padding:10px 12px 6px}
.overview table{width:100%;border-collapse:collapse;font-size:11px;min-width:480px}
.overview th{background:#f0fdf4;color:#047857;font-weight:600;padding:6px 8px;text-align:left;border-bottom:1px solid #e5e7eb}
.overview td{padding:6px 8px;border-bottom:1px solid #f3f4f6;vertical-align:top}
.overview .num{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:10px;font-weight:700;color:#fff;background:#059669;flex-shrink:0}
.overview .sec-badge{font-size:9px;padding:1px 6px;border-radius:4px;font-weight:500;white-space:nowrap}{% for sid, color in SEC_BADGE_COLORS.items() %}
.sec-badge-{{ sid }}{background:#{{ color.bg }};color:#{{ color.fg }}}{% endfor %}
.nav-bar{position:sticky;top:0;z-index:100;background:#fff;border-bottom:1px solid #e5e7eb;padding:8px 0;display:flex;gap:2px;overflow-x:auto;-webkit-overflow-scrolling:touch;margin:10px 14px;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.nav-link{display:flex;align-items:center;gap:3px;padding:4px 10px;font-size:11px;font-weight:600;color:#666;text-decoration:none;border-radius:6px;white-space:nowrap;transition:all .15s;flex-shrink:0}
.nav-link.active,.nav-link:active{background:#059669;color:#fff}
.sec{margin:10px 14px;background:#fff;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.04);overflow:hidden}
.sec-title{font-size:15px;font-weight:700;padding:10px 12px;border-bottom:2px solid #e5e7eb;display:flex;align-items:center;gap:6px}
.sec-title .badge{font-size:10px;background:#e5e7eb;color:#666;padding:1px 8px;border-radius:8px;font-weight:600;margin-left:auto}
.sec-empty{display:block;padding:16px 12px;text-align:center;font-size:12px;color:#999;border-bottom:1px solid #f3f4f6}
.card{display:block;padding:10px 12px;text-decoration:none;color:inherit;border-bottom:1px solid #f3f4f6}
.card:last-child{border-bottom:none}
.card:active{background:#f8f9fa}
.card-top{display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap}
.card-num{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:9px;font-weight:700;color:#fff;flex-shrink:0}
.card-source{font-size:10px;color:#059669;font-weight:600}
.card-date{font-size:10px;color:#999;margin-left:auto}
.card-title{font-size:13px;font-weight:600;color:#111;margin-bottom:3px;line-height:1.4}
.card-summary{font-size:12px;color:#666;line-height:1.5;margin-bottom:4px}
.card-tags{display:flex;gap:4px;flex-wrap:wrap}
.card-tag{font-size:9px;color:#888;background:#f3f4f6;padding:1px 6px;border-radius:4px;white-space:nowrap}
.footer{text-align:center;padding:16px 14px;font-size:11px;color:#999;background:#f0fdf4;margin:10px 14px;border-radius:8px;border:1px solid #bbf7d0}
.footer a{color:#059669;text-decoration:none;font-weight:600}{% for sid, color in SEC_COLORS.items() %}
.sec-{{ sid }} .sec-title{border-left:3px solid #{{ color }}}{% endfor %}
</style>
</head>
<body>

<div class="header">
  <div class="sub">AUTONOMOUS DRIVING · DAILY BRIEF</div>
  <h1>🚗 自动驾驶晨报</h1>
  <div class="meta">{{ date_display }} · 精选 <strong style="color:#a7f3d0">{{ total }}</strong> 条动态</div>
</div>

<div class="overview">
  <div class="overview-title">📋 今日概览</div>
  <table>
    <thead>
      <tr><th style="width:30px">#</th><th>标题</th><th style="width:60px">板块</th><th style="width:50px">来源</th></tr>
    </thead>
    <tbody>
{% for item in flat_items %}
      <tr><td><span class="num">{{ item.num }}</span></td><td>{{ item.title_esc }}</td><td><span class="sec-badge sec-badge-{{ item.sec_id }}">{{ item.sec_name }}</span></td><td>{{ item.source_esc }}</td></tr>
{% endfor %}
    </tbody>
  </table>
</div>

<nav class="nav-bar">
{% for sec in sections_nonempty %}
  <a href="#{{ sec.id }}" class="nav-link">{{ sec.icon }} {{ sec.name }}</a>
{% endfor %}
</nav>

{% for sec in sections_nonempty %}
<div class="sec sec-{{ sec.id[-1] }}" id="{{ sec.id }}">
<div class="sec-title">{{ sec.icon }} {{ sec.name }}<span class="badge">{{ sec.count }}</span></div>
{% for card in sec.cards %}
<a class="card" href="{{ card.url }}" target="_blank" rel="noopener noreferrer">
<div class="card-top"><span class="card-num" style="background:#{{ sec.num_color }}">{{ card.num }}</span><span class="card-source">{{ card.source_esc }}</span><span class="card-date">{{ card.date }}</span></div>
<div class="card-title">{{ card.title_esc }}</div>
<div class="card-summary">{{ card.summary_esc }}</div>
<div class="card-tags">{% for tag in card.tags %}<span class="card-tag">{{ tag }}</span>{% endfor %}</div>
</a>
{% endfor %}
</div>
{% endfor %}

{% for sec in sections_empty %}
<div class="sec sec-{{ sec.id[-1] }}" id="{{ sec.id }}">
<div class="sec-title">{{ sec.icon }} {{ sec.name }}<span class="badge">0</span></div>
<div class="sec-empty">本日暂无相关新闻 · 不凑数</div>
</div>
{% endfor %}

<div class="footer">
  📮 由 AI 自动生成 · 所有链接经搜索验证<br/>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('.sec');
  const navLinks = document.querySelectorAll('.nav-link');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(l => l.classList.remove('active'));
        const activeLink = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
        if (activeLink) activeLink.classList.add('active');
      }
    });
  }, { threshold: 0.2 });
  sections.forEach(s => observer.observe(s));
});
</script>
</body>
</html>
